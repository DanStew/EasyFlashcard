# ==============================================================================
# EasyFlashcard - Frontend Environment Variables
# ==============================================================================

# API Base URL for backend communications
# ------------------------------------------------------------------------------
# 1. Local Browser Dev (Vite proxy / Nginx reverse proxy):
#    Leave empty or set to /api/v1 (default)
#    VITE_API_BASE_URL=/api/v1
#
# 2. Local Mobile Phone Testing (over local Wi-Fi LAN):
#    VITE_API_BASE_URL=http://192.168.1.77:8000/api/v1
#
# 3. Android Emulator (Android virtual device loopback):
#    VITE_API_BASE_URL=http://10.0.2.2:8000/api/v1
#
# 4. Deployed Google Cloud Run (Production / Staging):
#    VITE_API_BASE_URL=https://<your-cloud-run-service-url>.a.run.app/api/v1

VITE_API_BASE_URL=
