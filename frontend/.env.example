# ==============================================================================
# EasyFlashcard - Frontend Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPTION A: Google Cloud Run (Deployed Production / Remote Backend & APK Default)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://easyflashcard-backend-xxxxx-ew.a.run.app/api/v1

# ------------------------------------------------------------------------------
# 2. OPTION B: Local Development Backend (Docker Compose or local Python server)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=/api/v1

# Optional: Host PC LAN address for physical phone Wi-Fi debugging
# VITE_LAN_BASE_URL=http://192.168.1.100:8000/api/v1

# ------------------------------------------------------------------------------
# 3. Firebase Web Application Configuration
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 Client Credentials (Persistent Google Drive Integration)
# ------------------------------------------------------------------------------
VITE_OAUTH_CLIENT_ID=your_oauth_client_id_here.apps.googleusercontent.com

