# ==============================================================================
# EasyFlashcard - Root .gitignore
# ==============================================================================

# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs and Editors
# ------------------------------------------------------------------------------
.agents/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!*.env.example
*.local
credentials.json
gcp-oauth.keys.json
token.json
.gdrive-token.json
*token.json

# Logs and Diagnostics
# ------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python & Backend Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Python Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, Type Checking & Linting Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.tox/

# Local Databases & Storage
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
data/

# Frontend / Node Artifacts
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.eslintcache
.stylelintcache
.vite/
.parcel-cache/
.turbo/

# Temporary Files
# ------------------------------------------------------------------------------
tmp/
temp/
.tmp/
