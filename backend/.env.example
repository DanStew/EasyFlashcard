# ==============================================================================
# EasyFlashcard - Backend Environment Variables Configuration
# ==============================================================================

APP_NAME=EasyFlashcard API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Storage backend: "memory" (local in-memory dev) or "firestore" (Google Cloud Firestore)
STORAGE_BACKEND=firestore

# Google Cloud & Firestore project identifier
FIREBASE_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE=(default)

# Path to service account credentials for local Firestore testing inside Docker
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json

# Fallback developer user ID when testing without auth token
DEFAULT_USER_ID=dev_user_123

# Prepopulate sample study sets in memory mode
AUTO_SEED_DEV_DATA=false

# Google OAuth 2.0 Web Client Credentials for persistent Google Drive integration
OAUTH_CLIENT_ID=your_oauth_client_id_here.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# Vertex AI & Gemini Configuration (for AI Flashcard Studio)
# Location can be global, us-central1, europe-west1, etc.
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=global
GEMINI_MODEL_NAME=gemini-3.7-flash



