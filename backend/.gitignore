# ==============================================================================
# EasyFlashcard - Backend .gitignore (Python / FastAPI)
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.tox/

# Local Databases
*.db
*.sqlite
*.sqlite3

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# IDEs & OS
.DS_Store
Thumbs.db
.vscode/
.idea/
